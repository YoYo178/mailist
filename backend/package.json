{
  "name": "mailist-backend",
  "version": "1.0.0",
  "description": "An Email triage AI agent",
  "keywords": [],
  "homepage": "https://github.com/YoYo178/mailist#readme",
  "bugs": {
    "url": "https://github.com/YoYo178/mailist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoYo178/mailist.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx --env-file=secrets/.env --env-file-if-exists=secrets/.env.development --watch src/index.ts",
    "start": "node --env-file=secrets/.env --env-file-if-exists=secrets/.env.production build/index.js",
    "worker:dev": "tsx --env-file=secrets/.env --env-file-if-exists=secrets/.env.development --watch src/workers/index.ts",
    "worker": "node --env-file=secrets/.env --env-file-if-exists=secrets/.env.production build/workers/index.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "bullmq": "^6.7.0",
    "connect-redis": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "googleapis": "^189.0.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.12.0",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
