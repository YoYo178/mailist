{
  "name": "mailist-backend",
  "version": "1.0.0",
  "description": "An Email triage AI agent",
  "keywords": [],
  "homepage": "https://github.com/YoYo178/mailist#readme",
  "bugs": {
    "url": "https://github.com/YoYo178/mailist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoYo178/mailist.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch --env-file=secrets/.env --env-file-if-exists=secrets/.env.development src/index.ts",
    "start": "node --env-file=secrets/.env --env-file-if-exists=secrets/.env.production build/index.js",
    "worker:dev": "tsx watch --env-file=secrets/.env --env-file-if-exists=secrets/.env.development src/workers/index.ts",
    "worker": "node --env-file=secrets/.env --env-file-if-exists=secrets/.env.production build/workers/index.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.10",
    "connect-redis": "^11.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "googleapis": "^190.0.0",
    "ioredis": "^6.1.0",
    "mongoose": "^9.13.1",
    "redis": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.11",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsc-alias": "^1.9.11",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
